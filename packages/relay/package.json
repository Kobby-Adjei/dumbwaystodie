    "dev": "node dist/server.js",
    "test": "node --test test/*.test.js"
  },
  "dependencies": {
    "@dumbways/protocol": "*",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/ws": "^8.5.12"
  }
}
