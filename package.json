{
  "name": "dumbways-to-die",
  "version": "0.1.0",
  "private": true,
  "description": "Local-first VS Code learning/agent bridge. Milestone A.",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "packages/protocol",
    "packages/relay",
    "packages/mock-provider",
    "packages/mcp-server",
    "packages/browser-adapter",
    "packages/extension"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "clean": "rm -rf packages/*/dist packages/*/out packages/*/*.tsbuildinfo",
    "pretest": "npm run build",
    "test": "npm run test --workspaces --if-present",
    "dev:extension": "npm run build --workspace packages/protocol && npm run build --workspace packages/mock-provider && npm run watch --workspace packages/extension",
    "dev:relay": "npm --workspace packages/relay run dev",
    "dev:provider": "npm --workspace packages/mock-provider run dev",
    "dev:stack": "node scripts/dev-stack.js",
    "dev:browser": "npm --workspace packages/browser-adapter run watch"
  },
  "devDependencies": {
    "typescript": "^5.6.3"
  }
}
